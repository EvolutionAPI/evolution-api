# ============================================================
#  GhostSender — Configuração de Ambiente
# ============================================================

# URL base da sua instância da Evolution API (sem barra no final)
EVOLUTION_API_URL=http://localhost:8080

# Chave de API global da Evolution API (AUTHENTICATION_API_KEY no .env da API)
EVOLUTION_API_KEY=sua-chave-global-aqui

# ── Warmup ──────────────────────────────────────────────────
# Instâncias disponíveis para warmup (separadas por vírgula)
WARMUP_INSTANCES=instancia1,instancia2,instancia3

# Fase inicial do warmup (1 = começo, ajusta o volume de mensagens)
WARMUP_START_PHASE=1

# Janela de horário permitido para envio (formato HH:MM)
WARMUP_HOUR_START=08:00
WARMUP_HOUR_END=22:00

# Delay mínimo e máximo entre mensagens (em milissegundos)
WARMUP_MIN_DELAY_MS=15000
WARMUP_MAX_DELAY_MS=90000

# ── Blast / Disparo ─────────────────────────────────────────
# Concorrência máxima de envios simultâneos
BLAST_CONCURRENCY=5

# Delay entre cada número no disparo (ms)
BLAST_DELAY_BETWEEN_MS=3000

# ── Verificação de Número ──────────────────────────────────
# Instância padrão usada para verificar números
VERIFY_DEFAULT_INSTANCE=instancia1

# ── Logs ───────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=ghostsender.log
